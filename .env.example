# RPC Configuration (use your paid Helius RPC)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
BACKUP_RPC_URL=https://api.mainnet-beta.solana.com
RPC_TIMEOUT=5000
MAX_RPC_CALLS_PER_SECOND=100

# Wallet Configuration
PHANTOM_PRIVATE_KEY=YOUR_PHANTOM_PRIVATE_KEY
BACKUP_WALLET_PRIVATE_KEY=YOUR_BACKUP_PRIVATE_KEY
MAX_SOL_PER_TRADE=0.01
MAX_CONCURRENT_POSITIONS=5
EMERGENCY_STOP=false

# Trading Configuration
STOP_LOSS_PERCENT=10
TAKE_PROFIT_PERCENT=50
POSITION_TTL_MINUTES=30
MIN_LIQUIDITY_USD=500
MAX_MARKET_CAP_USD=10000000

# Logging Configuration
LOG_LEVEL=info
LOG_RETENTION_DAYS=7
SESSION_LOG_CLEANUP=true

# Telegram Notifications
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID
ENABLE_NOTIFICATIONS=true

# Development
NODE_ENV=production
PORT=3000
